<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenshotCapture.FloatingCaptureWindow"
        Width="154" Height="52"
        CanResize="False" WindowDecorations="None" ShowInTaskbar="False" Topmost="True"
        Title="快速截圖">
  <Border Margin="4" Background="#155EEF" CornerRadius="24" Padding="4" BoxShadow="0 8 24 0 #40000000">
    <Button Click="CaptureCurrentScreen" Background="Transparent" BorderThickness="0" Foreground="White" FontWeight="SemiBold" FontSize="14">
      立即截圖
    </Button>
  </Border>
</Window>