<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenshotCapture.MainWindow"
        x:CompileBindings="False"
        Width="600" Height="390" MinWidth="520" MinHeight="340"
        Title="Screenshot Capture" Icon="/Assets/capture-buddy.ico">
  <Grid RowDefinitions="Auto,*,Auto" Margin="32" RowSpacing="24">
    <StackPanel Spacing="8">
      <TextBlock Text="全螢幕截圖" FontSize="28" FontWeight="SemiBold" Foreground="#182230" />
      <TextBlock Text="使用置頂的浮動按鈕，一按即可儲存整個桌面畫面。" Foreground="#475467" FontSize="14" />
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="14" Padding="22">
      <StackPanel Spacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="快速截圖已啟用" FontSize="17" FontWeight="SemiBold" Foreground="#182230" />
          <TextBlock Text="螢幕上的「立即全螢幕截圖」按鈕會先隱藏本程式，再擷取所有顯示器畫面。" TextWrapping="Wrap" Foreground="#667085" FontSize="14" />
        </StackPanel>
        <Border Background="#EFF4FF" CornerRadius="8" Padding="13">
          <TextBlock Text="截圖會儲存至「圖片\ScreenshotCapture」。擷取期間系統主音量會暫時設為 0%，完成後立即還原。" TextWrapping="Wrap" Foreground="#1849A9" FontSize="13" />
        </Border>
        <TextBlock Text="若要回到這個視窗，請使用浮動按鈕下方的「返回 ScreenshotCapture」。" TextWrapping="Wrap" Foreground="#475467" FontSize="13" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#475467" TextWrapping="Wrap" />
      <Button Grid.Column="1" Click="OpenCaptureFolder" IsEnabled="{Binding CanOpenCaptureFolder}" Padding="16,10">開啟截圖資料夾</Button>
    </Grid>
  </Grid>
</Window>